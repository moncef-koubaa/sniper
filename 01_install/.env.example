# Machine settings for the PFE campaign, read by campaign/scheduler/platform_env.py.
# install.ps1 / install.sh copy this file to ROOT/.env (the folder that holds sniper, later campaign,
# interviews, my documents and guides) if it is not there yet. Every key is optional: leave a value empty
# to let the scripts find the tool themselves. Variables already set in the environment win over this file.
# Nothing personal goes here: your details live in campaign/00_profile/personalisation_map.json.

# Python that runs the campaign scripts. install.sh sets it to ROOT/.venv/bin/python;
# on Windows install.ps1 sets it to %LOCALAPPDATA%\Programs\Python\Python312\python.exe.
PYTHON=

# How build.py and make_runbook.py turn .docx into .pdf: auto, word or libreoffice.
# auto = Microsoft Word (Windows/macOS, through docx2pdf) when present, otherwise LibreOffice.
PDF_ENGINE=auto

# LibreOffice binary, if it is not on PATH (Windows: C:\Program Files\LibreOffice\program\soffice.exe).
SOFFICE_PATH=

# Chrome or Chromium binary, if it is not found (Linux: /usr/bin/google-chrome).
CHROME_PATH=

# Chrome user-data folder holding your campaign profile, if not the default
# (Windows: %LOCALAPPDATA%\Google\Chrome\User Data, Linux: ~/.config/google-chrome,
#  macOS: ~/Library/Application Support/Google/Chrome).
CHROME_USER_DATA=

# Claude Code binary, if it is not in ~/.local/bin or on PATH.
CLAUDE_PATH=
